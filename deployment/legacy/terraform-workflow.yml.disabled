name: Terraform AWS Infrastructure

on:
  workflow_dispatch:
    inputs:
      operation:
        description: Plan only, or apply the reviewed plan after environment approval
        type: choice
        options: [plan, apply]
        default: plan
        required: true
      confirmation:
        description: 'For apply, type: APPLY gratilo-prd-iac'
        type: string
        default: ''
      image_tag:
        description: Immutable ECR release tag (keep current tag for infrastructure-only updates)
        type: string
        default: initial
        required: true
      desired_count:
        description: ECS task count; keep 0 until images, secrets and database are ready
        type: choice
        options: ['0', '1', '2', '3', '4']
        default: '0'
        required: true
      db_multi_az:
        description: Enable a second RDS node (additional cost)
        type: boolean
        default: false

permissions:
  contents: read

# Covers both planning and approval/apply; never cancel a running apply.
concurrency:
  group: gratilo-prd-terraform
  cancel-in-progress: false

env:
  TF_VERSION: '1.13.5'
  TF_IN_AUTOMATION: 'true'
  TF_INPUT: 'false'
  TF_WORKSPACE: default
  AWS_REGION: eu-central-1
  AWS_DEFAULT_REGION: eu-central-1
  AWS_EC2_METADATA_DISABLED: 'true'
  AWS_PROFILE: ${{ vars.TERRAFORM_AWS_PROFILE }}
  TF_VAR_aws_account_id: ${{ vars.AWS_ACCOUNT_ID }}
  TF_VAR_mail_from_email: ${{ vars.TERRAFORM_MAIL_FROM_EMAIL || 'noreply@gratilo.eu' }}
  TF_VAR_environment: prd
  TF_VAR_domain_name: gratilo.de
  TF_VAR_db_instance_class: db.t4g.micro
  TF_VAR_db_multi_az: ${{ inputs.db_multi_az }}
  TF_VAR_image_tag: ${{ inputs.image_tag }}
  TF_VAR_desired_count: ${{ inputs.desired_count }}

jobs:
  plan:
    name: Validate and plan
    if: github.ref == 'refs/heads/main'
    # Dedicated trusted Linux runner with AWS CLI, Python 3 and local AWS_PROFILE.
    runs-on: [self-hosted, linux, x64, terraform]
    timeout-minutes: 30
    defaults:
      run:
        shell: bash
        working-directory: infrastructure
    outputs:
      artifact: ${{ steps.metadata.outputs.artifact }}
      bucket: ${{ steps.metadata.outputs.bucket }}
      account_id: ${{ steps.metadata.outputs.account_id }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}
          terraform_wrapper: false
      - name: Check configuration and explicit apply request
        id: metadata
        env:
          OPERATION: ${{ inputs.operation }}
          CONFIRMATION: ${{ inputs.confirmation }}
          STATE_BUCKET: ${{ vars.TERRAFORM_STATE_BUCKET }}
        run: |
          set -euo pipefail
          if [[ "$OPERATION" == apply && "$CONFIRMATION" != 'APPLY gratilo-prd-iac' ]]; then
            echo 'Apply requires the exact confirmation: APPLY gratilo-prd-iac' >&2
            exit 1
          fi
          for name in AWS_PROFILE STATE_BUCKET TF_VAR_aws_account_id TF_VAR_mail_from_email; do
            [[ -n "${!name}" ]] || { echo "Missing configuration: $name" >&2; exit 1; }
          done
          [[ "$STATE_BUCKET" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ ]]
          [[ "$TF_VAR_aws_account_id" =~ ^[0-9]{12}$ ]]
          echo "artifact=terraform-plan-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}" >> "$GITHUB_OUTPUT"
          echo "bucket=$STATE_BUCKET" >> "$GITHUB_OUTPUT"
          echo "account_id=$TF_VAR_aws_account_id" >> "$GITHUB_OUTPUT"
          # Never allow inherited environment access keys to override the CLI profile.
          for name in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN; do
            echo "$name=" >> "$GITHUB_ENV"
          done
      - name: Verify profile account
        run: |
          set -euo pipefail
          account=$(aws sts get-caller-identity --profile "$AWS_PROFILE" --query Account --output text)
          [[ "$account" == "$TF_VAR_aws_account_id" ]] || { echo 'AWS account mismatch' >&2; exit 1; }
      - name: Initialize shared state
        env:
          STATE_BUCKET: ${{ steps.metadata.outputs.bucket }}
        run: |
          terraform init -input=false -lockfile=readonly \
            -backend-config="bucket=$STATE_BUCKET" \
            -backend-config="expected_bucket_owner=$TF_VAR_aws_account_id"
      - name: Format and validate
        run: |
          terraform fmt -check -recursive
          terraform validate -no-color
      - name: Create saved plan
        run: |
          terraform plan -input=false -lock-timeout=5m -out=deployment.tfplan
          terraform show -no-color deployment.tfplan > deployment-plan.txt
          {
            echo '### Terraform plan ready'
            echo 'Download the plan artifact and review deployment-plan.txt before approving the apply job.'
            echo 'Target: gratilo-prd-iac / eu-central-1. PostgreSQL: db.t4g.micro.'
            echo "Commit: $GITHUB_SHA"
          } >> "$GITHUB_STEP_SUMMARY"
      - name: Store the exact plan for review and apply
        uses: actions/upload-artifact@v4
        with:
          name: ${{ steps.metadata.outputs.artifact }}
          path: |
            infrastructure/deployment.tfplan
            infrastructure/deployment-plan.txt
          if-no-files-found: error
          retention-days: 1
      - name: Remove local plan files from the persistent runner
        if: always()
        run: rm -f deployment.tfplan deployment-plan.txt

  apply:
    name: Apply reviewed plan
    needs: plan
    if: inputs.operation == 'apply' && inputs.confirmation == 'APPLY gratilo-prd-iac' && github.ref == 'refs/heads/main'
    runs-on: [self-hosted, linux, x64, terraform]
    timeout-minutes: 90
    # Configure REQUIRED REVIEWERS for this environment before enabling this workflow.
    environment: terraform-prd
    defaults:
      run:
        shell: bash
        working-directory: infrastructure
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}
          terraform_wrapper: false
      - uses: actions/download-artifact@v4
        with:
          name: ${{ needs.plan.outputs.artifact }}
          path: infrastructure
      - name: Verify profile and initialize the same state
        env:
          STATE_BUCKET: ${{ needs.plan.outputs.bucket }}
          EXPECTED_ACCOUNT: ${{ needs.plan.outputs.account_id }}
        run: |
          set -euo pipefail
          unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN
          for name in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN; do
            echo "$name=" >> "$GITHUB_ENV"
          done
          [[ -n "$AWS_PROFILE" ]]
          account=$(aws sts get-caller-identity --profile "$AWS_PROFILE" --query Account --output text)
          [[ "$account" == "$EXPECTED_ACCOUNT" ]] || { echo 'AWS account mismatch' >&2; exit 1; }
          terraform init -input=false -lockfile=readonly \
            -backend-config="bucket=$STATE_BUCKET" \
            -backend-config="expected_bucket_owner=$EXPECTED_ACCOUNT"
      - name: Apply only the saved plan
        run: terraform apply -input=false -lock-timeout=5m deployment.tfplan
      - name: Remove local plan files from the persistent runner
        if: always()
        run: rm -f deployment.tfplan deployment-plan.txt
