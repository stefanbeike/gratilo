{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": [
        "arn:aws:ecr:eu-central-1:<AWS_ACCOUNT_ID>:repository/gratilo/frontend",
        "arn:aws:ecr:eu-central-1:<AWS_ACCOUNT_ID>:repository/gratilo/user-service",
        "arn:aws:ecr:eu-central-1:<AWS_ACCOUNT_ID>:repository/gratilo/payment-service"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-central-1:<AWS_ACCOUNT_ID>:log-group:<CLOUDWATCH_LOG_GROUP>:log-stream:*"
    },
    {
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:gratilo/prd/app-<SECRET_SUFFIX>"
      ]
    }
  ]
}
