{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyGratiloImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeImages"
      ],
      "Resource": [
        "arn:aws:ecr:eu-central-1:<AWS_ACCOUNT_ID>:repository/gratilo/frontend",
        "arn:aws:ecr:eu-central-1:<AWS_ACCOUNT_ID>:repository/gratilo/user-service",
        "arn:aws:ecr:eu-central-1:<AWS_ACCOUNT_ID>:repository/gratilo/payment-service"
      ]
    },
    {
      "Sid": "RegisterRevision",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:task-definition/<ECS_TASK_FAMILY>:*"
    },
    {
      "Sid": "ReadTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "TagNewRevision",
      "Effect": "Allow",
      "Action": "ecs:TagResource",
      "Resource": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:task-definition/<ECS_TASK_FAMILY>:*",
      "Condition": {
        "StringEquals": {
          "ecs:CreateAction": "RegisterTaskDefinition"
        }
      }
    },
    {
      "Sid": "UpdateOnlyProductionService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:service/<ECS_CLUSTER>/<ECS_SERVICE>"
    },
    {
      "Sid": "ListOnlyProductionServiceTasks",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:cluster/<ECS_CLUSTER>"
        }
      }
    },
    {
      "Sid": "DiagnoseStoppedTasks",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:task/<ECS_CLUSTER>/*"
    },
    {
      "Sid": "PassOnlyEcsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/<ECS_TASK_EXECUTION_ROLE_NAME>",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/<ECS_TASK_ROLE_NAME>"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadTaskDefinitionTags",
      "Effect": "Allow",
      "Action": "ecs:ListTagsForResource",
      "Resource": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:task-definition/<ECS_TASK_FAMILY>:*"
    }
  ]
}
