# Copy to the ignored root .env.stripe-test, or use stripe_test.py init.
# Real values must never be committed. No AWS configuration is used.
STRIPE_SECRET_KEY=replace_with_sandbox_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=replace_with_sandbox_publishable_key
STRIPE_WEBHOOK_SECRET=replace_with_listener_signing_secret
LOCAL_POSTGRES_PASSWORD=replace_with_random_local_password
JWT_SECRET=replace_with_at_least_32_random_characters
INTERNAL_API_KEY=replace_with_a_separate_random_value
PAYMENTS_TEST_ACTIVATION_CODE=replace_with_32_to_256_random_characters
FRONTEND_BASE_URL=http://localhost:3001
FEATURE_TIP_POOLS_ENABLED=false

# International-card reference estimate (Stripe DE); differences are borne by Gratilo.
STRIPE_FEE_PERCENT=3.15
STRIPE_FEE_FIXED_MINOR=25
