{
  "uid": "gratilo-07-backend",
  "title": "07 · Backend und API-Performance",
  "description": "HTTP-, JVM-, Datenbank- und Operationsmetriken beider Micronaut-Dienste.",
  "tags": [
    "gratilo",
    "observability"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "style": "dark",
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Gratilo-Dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "gratilo"
      ],
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Umgebung",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gratilo-prometheus"
        },
        "definition": "label_values(up{job=\"prometheus\"}, environment)",
        "query": {
          "query": "label_values(up{job=\"prometheus\"}, environment)",
          "refId": "scope"
        },
        "refresh": 1,
        "current": {
          "text": "demo",
          "value": "demo"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Dienst",
        "type": "custom",
        "query": "user-service,payment-service",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "user-service",
            "value": "user-service",
            "selected": false
          },
          {
            "text": "payment-service",
            "value": "payment-service",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP und Verfügbarkeit",
      "description": "",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Anfragen je Sekunde",
      "description": "HTTP-Rate einschließlich interner Requests, ohne Scrape-Route.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gratilo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "sum by (service)(rate(gratilo_http_server_requests_seconds_count{environment=~\"${environment:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Unbekannt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP-5xx-Fehlerrate je Dienst",
      "description": "HTTP-5xx geteilt durch alle beobachteten Requests je Dienst.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gratilo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "((sum by (service)(rate(gratilo_http_server_requests_seconds_count{environment=~\"${environment:regex}\",service=~\"${service:regex}\",status_class=\"5xx\"}[$__rate_interval]))) or 0 * (sum by (service)(rate(gratilo_http_server_requests_seconds_count{environment=~\"${environment:regex}\",service=~\"${service:regex}\"}[$__rate_interval])))) / (sum by (service)(rate(gratilo_http_server_requests_seconds_count{environment=~\"${environment:regex}\",service=~\"${service:regex}\"}[$__rate_interval])))",
          "editorMode": "code",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unbekannt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
