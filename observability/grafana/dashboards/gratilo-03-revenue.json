            "type": "grafana-postgresql-datasource",
            "uid": "gratilo-postgres"
          },
          "rawSql": "SELECT value/100::numeric AS \"Wert\" FROM gratilo_monitor.payments(to_timestamp(${__from}/1000.0), to_timestamp(${__to}/1000.0), (${stripe_mode:sqlstring} = 'live'), ${kind:sqlstring}) WHERE metric = 'tip_volume' AND ${environment:sqlstring} = gratilo_monitor.environment() ORDER BY dimension",
