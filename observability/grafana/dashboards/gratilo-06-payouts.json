    {
      "id": 2,
      "title": "Connected Accounts",
      "description": "Konten mit Stripe-Referenz. Nutzer und Pools gelten für die Umgebung. Der Stripe-Modus gilt für Connect.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gratilo-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "gratilo-postgres"
          },
          "rawSql": "SELECT value AS \"Wert\" FROM gratilo_monitor.users(to_timestamp(${__from}/1000.0), to_timestamp(${__to}/1000.0), (${stripe_mode:sqlstring} = 'live')) WHERE metric = 'connected' AND ${environment:sqlstring} = gratilo_monitor.environment() ORDER BY dimension",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unbekannt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
