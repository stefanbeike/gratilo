    {
      "id": 6,
      "title": "Registrierungs-Erfolgsquote",
      "description": "HTTP 2xx geteilt durch alle beobachteten Aufrufe der Route.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gratilo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "((sum(increase(gratilo_http_server_requests_seconds_count{environment=~\"${environment:regex}\",endpoint_template=\"/user-service/users/register\",status_class=\"2xx\"}[$__range]))) or 0 * (sum(increase(gratilo_http_server_requests_seconds_count{environment=~\"${environment:regex}\",endpoint_template=\"/user-service/users/register\"}[$__range])))) / (sum(increase(gratilo_http_server_requests_seconds_count{environment=~\"${environment:regex}\",endpoint_template=\"/user-service/users/register\"}[$__range])))",
