            "type": "grafana-postgresql-datasource",
            "uid": "gratilo-postgres"
          },
          "rawSql": "SELECT \"time\", registrations AS \"Wert\" FROM gratilo_monitor.registrations(to_timestamp(${__from}/1000.0), to_timestamp(${__to}/1000.0), 'day') WHERE ${environment:sqlstring} = gratilo_monitor.environment() ORDER BY \"time\"",
