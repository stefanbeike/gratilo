    {
      "id": 2,
      "title": "Container-Arbeitsspeicher · cgroup v2",
      "description": "Linux-cgroup des App-Containers. CPU-Nutzung wird als verbrauchte CPU-Kerne angegeben.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gratilo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "gratilo_cgroup_memory_bytes{environment=~\"${environment:regex}\",service=~\"${service:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unbekannt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
