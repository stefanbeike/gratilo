    {
      "id": 5,
      "title": "HTTP-Probe-Verfügbarkeit · beobachtete Stichproben",
      "description": "Anteil erfolgreicher Probes im gewählten Zeitraum. Scrape-Lücken reduzieren die Beweiskraft.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gratilo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "avg_over_time(probe_success[$__range])",
          "editorMode": "code",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
