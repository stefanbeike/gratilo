  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Umgebung",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gratilo-prometheus"
        },
        "definition": "label_values(up{job=\"prometheus\"}, environment)",
        "query": {
          "query": "label_values(up{job=\"prometheus\"}, environment)",
          "refId": "scope"
        },
        "refresh": 1,
        "current": {
          "text": "demo",
          "value": "demo"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Dienst",
        "type": "custom",
        "query": "user-service,payment-service",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "user-service",
            "value": "user-service",
            "selected": false
          },
          {
            "text": "payment-service",
            "value": "payment-service",
            "selected": false
