      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "sum(increase(gratilo_http_security_responses_total{environment=~\"${environment:regex}\",service=~\"${service:regex}\",category=\"rate_limit\"}[$__range]))",
          "editorMode": "code",
          "legendFormat": "",
          "instant": true,
          "range": false
