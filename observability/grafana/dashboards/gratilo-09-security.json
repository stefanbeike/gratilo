    {
      "id": 2,
      "title": "Authentifizierungs- und Autorisierungsfehler",
      "description": "Feste Kategorien HTTP 401/403 einschließlich Login-Ausgang. Keine Rohpfade oder Benutzer.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gratilo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "sum by (service,category)(rate(gratilo_http_security_responses_total{environment=~\"${environment:regex}\",service=~\"${service:regex}\",category!=\"rate_limit\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "{{service}} · {{category}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Unbekannt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
