          "rawSql": "SELECT dimension AS \"Kategorie\", value AS \"Wert\" FROM gratilo_monitor.payments(to_timestamp(${__from}/1000.0), to_timestamp(${__to}/1000.0), (${stripe_mode:sqlstring} = 'live'), 'ALL') WHERE metric = 'audit_missing' AND ${environment:sqlstring} = gratilo_monitor.environment() ORDER BY dimension",
