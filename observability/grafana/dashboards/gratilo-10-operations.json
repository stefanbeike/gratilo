    {
      "id": 2,
      "title": "Grafana Alert Center",
      "description": "Grafana-managed Regeln mit Pending- und Firing-Zustand.",
      "type": "alertlist",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 10
      },
      "options": {
        "showOptions": "current",
        "maxItems": 50,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "normal": false,
          "noData": true,
          "error": true
        }
      }
    },
    {
      "id": 3,
      "title": "Kritische Alarme",
      "description": "Anzahl aktuell feuernder Regeln im Prometheus-Spiegel.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gratilo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gratilo-prometheus"
          },
          "expr": "sum(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or 0*count(up{job=\"prometheus\"})",
          "editorMode": "code",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unbekannt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      }
    },
