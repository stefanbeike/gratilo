# Safe placeholders only. Real values belong exclusively in your ignored local .env.
STRIPE_SECRET_KEY=replace_me
STRIPE_PUBLISHABLE_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me

# Optional local URLs
STRIPE_SUCCESS_URL=http://localhost:3000/pay/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/pay/cancelled

# Group tipping is disabled by default (both backend services).
FEATURE_TIP_POOLS_ENABLED=false

# Production SES SMTP (user-service, MICRONAUT_ENVIRONMENTS=prd).
# Local Compose continues to use MailHog. Inject credentials from Secrets Manager
# into ECS secrets; never put real credentials in this example or task JSON.
# MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
# MAIL_PORT=587
# MAIL_FROM_EMAIL=noreply@gratilo.eu
# MAIL_GENERAL_FROM_EMAIL=info@gratilo.eu
# MAIL_FROM_NAME=Gratilo
# JAVAMAIL_AUTHENTICATION_USERNAME=<SES SMTP username>
# JAVAMAIL_AUTHENTICATION_PASSWORD=<SES SMTP password>
