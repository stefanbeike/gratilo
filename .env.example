# Safe placeholders only. Real values belong exclusively in your ignored local .env.
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
# Public sandbox key only; forwarded as a frontend build argument.
VITE_STRIPE_PUBLISHABLE_KEY=replace_me

# Optional local URLs
STRIPE_SUCCESS_URL=http://localhost:3000/pay/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/pay/cancelled

# Payments require explicit activation for local test runs only.
PAYMENTS_ENABLED=false
# Optional legacy configuration; profile activation avoids entering user UUIDs.
PAYMENTS_TEST_USER_IDS=
# Private operator code (32-256 random characters), backend only. Never VITE_ or QR URLs.
# PAYMENTS_TEST_ACTIVATION_CODE=<set privately; use activation_code JSON key in stripe-test secret>
VITE_PAYMENTS_ENABLED=false
STRIPE_TEST_ONLY=true
STRIPE_SANDBOX_PAYOUTS=true
STRIPE_DEMO_ENABLED=false

# Standard stack: pools disabled. Opt in explicitly in the isolated local sandbox.
FEATURE_TIP_POOLS_ENABLED=false

# Production SES SMTP (user-service, MICRONAUT_ENVIRONMENTS=prd).
# Local Compose continues to use MailHog. Inject credentials from Secrets Manager
# into ECS secrets; never put real credentials in this example or task JSON.
# MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
# MAIL_PORT=587
# MAIL_FROM_EMAIL=noreply@gratilo.eu
# MAIL_GENERAL_FROM_EMAIL=info@gratilo.eu
# MAIL_FROM_NAME=Gratilo
# JAVAMAIL_AUTHENTICATION_USERNAME=<SES SMTP username>
# JAVAMAIL_AUTHENTICATION_PASSWORD=<SES SMTP password>

JWT_SECRET=replace_me_with_random_value_of_at_least_32_bytes

INTERNAL_API_KEY=replace_me_with_a_separate_random_value

# Isolated local Stripe stack: python3 docker-compose/stripe_test.py init
# Uses its own ignored .env.stripe-test; see README "Lokaler Stripe-Sandbox-Stack".

# Separate Accounts-v2 thin-event destination (optional; leave blank until configured)
STRIPE_CONNECT_WEBHOOK_SECRET=

# Stripe DE international-card reference, not guaranteed for all Checkout methods.
# Actual differences are paid by Gratilo; never deducted from the promised tip.
STRIPE_FEE_PERCENT=3.15
STRIPE_FEE_FIXED_MINOR=25

# Direct-charge v1 snapshot destination; distinct from Accounts-v2 thin events.
# For a single local Stripe CLI listener this equals its local webhook secret.
STRIPE_DIRECT_WEBHOOK_SECRET=
# Kept disabled pending refund commission policy and actual sandbox acceptance.
GRATILO_NEW_PRICING_ENABLED=false
# Both personal and pool payments: 5% of the original tip, no fixed commission.
GRATILO_PLATFORM_FEE_PERCENT=5.00
GRATILO_PLATFORM_FEE_FIXED_MINOR=45

# Limits for newly selected pool tips, before Stripe surcharge.
GRATILO_POOL_TIP_MIN_MINOR=200
GRATILO_POOL_TIP_MAX_MINOR=50000

# Enable on both backend services after migrations; local SMTP remains MailHog.
TIP_PAYMENT_EMAILS_ENABLED=false

# Opt-in: Preview only for creating new Connect-v2 Express accounts. No account migration.
STRIPE_CONNECT_STRIPE_PRICING_ENABLED=false
STRIPE_CONNECT_PLATFORM_FEES_ENABLED=false

# Manual payout development: simulation stays enabled; never enable external POSTs implicitly.
STRIPE_MANUAL_PAYOUTS_API_APPROVED=false
# Optional restrictive test filter. Empty means all eligible app-owned accounts.
STRIPE_MANUAL_PAYOUT_APPROVED_ACCOUNTS=
# Enables idempotent manual-schedule setup only in approved external test mode.
STRIPE_MANUAL_PAYOUT_SETUP_ENABLED=false
